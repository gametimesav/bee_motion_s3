substitutions:
  low_battery_percent: "20"
  critical_battery_voltage: "3.40"


# ====================================================
# ESPHOME
# ====================================================

esphome:
  name: bee-motion-s3
  friendly_name: "Bee Motion S3"
  comment: "Bee Motion S3 optimized deep sleep with battery protection"

  on_boot:
    priority: -10
    then:

      # ------------------------------------------------
      # Wait for Home Assistant to subscribe to states.
      # ------------------------------------------------
      - wait_until:
          condition:
            api.connected:
              state_subscription_only: true
          timeout: 20s

      # ------------------------------------------------
      # Let Wi-Fi/API startup current settle before
      # taking the battery measurement.
      # ------------------------------------------------
      - delay: 2s

      # ------------------------------------------------
      # Fresh ambient light measurement.
      # ------------------------------------------------
      - component.update: ambient_light_raw

      # ------------------------------------------------
      # Five battery samples for averaging.
      # ------------------------------------------------
      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw

      # Allow averaging filter to publish.
      - delay: 250ms

      # ------------------------------------------------
      # Calculate battery voltage and percentage.
      # ------------------------------------------------
      - component.update: battery_voltage
      - component.update: battery_percent

      - delay: 250ms

      # ------------------------------------------------
      # Update wake diagnostics.
      # ------------------------------------------------
      - component.update: wakeup_cause
      - component.update: wakeup_reason

      # ------------------------------------------------
      # Publish low-battery warning.
      #
      # ON at <= 20%.
      # ------------------------------------------------
      - binary_sensor.template.publish:
          id: low_battery_warning
          state: !lambda |-
            float p = id(battery_percent).state;

            if (isnan(p)) {
              return false;
            }

            return p <= ${low_battery_percent};


      # ------------------------------------------------
      # Publish critical-battery warning.
      #
      # ON at <= 3.40V.
      # ------------------------------------------------
      - binary_sensor.template.publish:
          id: critical_battery_warning
          state: !lambda |-
            float v = id(battery_voltage).state;

            if (isnan(v)) {
              return false;
            }

            return v <= ${critical_battery_voltage};

      # Give Home Assistant time to receive states.
      - delay: 2s


      # =================================================
      # CRITICAL BATTERY PROTECTION
      # =================================================

      - if:
          condition:
            lambda: |-
              float v = id(battery_voltage).state;

              return !isnan(v) &&
                     v <= ${critical_battery_voltage};

          then:

            - logger.log:
                level: WARN
                format: "CRITICAL BATTERY: %.2f V - entering protective sleep"
                args:
                  - 'id(battery_voltage).state'

            # Give Home Assistant additional time
            # to receive the critical warning.
            - delay: 2s

            # Shut down PIR/light peripheral rail.
            #
            # This prevents PIR motion from repeatedly
            # waking the ESP32 while the battery is
            # critically discharged.
            - switch.turn_off: peripheral_power

            - delay: 100ms

            # Sleep for six hours.
            #
            # The timer will wake the ESP32 later to
            # check battery voltage again.
            - deep_sleep.enter:
                id: deep_sleep_control
                sleep_duration: 6h

          else:

            # Battery healthy enough for normal use.
            - deep_sleep.enter: deep_sleep_control


# ====================================================
# ESP32-S3
# ====================================================

esp32:
  board: esp32-s3-devkitc-1

  framework:
    type: arduino


# ====================================================
# LOGGER
# ====================================================

logger:
  level: INFO


# ====================================================
# HOME ASSISTANT API
# ====================================================

api:
  id: api_server

  encryption:
    key: !secret bee_motion_s3__encryption_key

  # Don't reboot simply because HA isn't reachable.
  reboot_timeout: 0s


# ====================================================
# OTA
# ====================================================

ota:
  - platform: esphome
    password: !secret bee_motion_s3__ota_password


# ====================================================
# WIFI
# ====================================================

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  fast_connect: true


# ====================================================
# PERIPHERAL POWER
#
# GPIO34 = LDO2 / onboard peripheral power
#
# Normally stays ON so PIR can wake the ESP32.
#
# It is switched OFF only when battery voltage
# reaches the critical protection threshold.
# ====================================================

switch:

  - platform: gpio
    pin:
      number: GPIO34

    id: peripheral_power

    internal: true

    restore_mode: ALWAYS_ON


# ====================================================
# BINARY SENSORS
# ====================================================

binary_sensor:

  # --------------------------------------------------
  # PIR MOTION
  #
  # GPIO4
  # --------------------------------------------------

  - platform: gpio

    pin:
      number: GPIO4

      mode:
        input: true
        pulldown: true

      allow_other_uses: true

    id: pir_motion

    name: "PIR Motion"

    device_class: motion

    filters:
      - delayed_off: 5s


  # --------------------------------------------------
  # USB / VBUS DETECTION
  #
  # GPIO2
  # --------------------------------------------------

  - platform: gpio

    pin:
      number: GPIO2

      mode:
        input: true

    id: usb_connected

    name: "USB Connected"

    device_class: plug


  # --------------------------------------------------
  # LOW BATTERY WARNING
  #
  # Published during every wake cycle.
  # --------------------------------------------------

  - platform: template

    id: low_battery_warning

    name: "Low Battery Warning"

    device_class: battery


  # --------------------------------------------------
  # CRITICAL BATTERY WARNING
  # --------------------------------------------------

  - platform: template

    id: critical_battery_warning

    name: "Critical Battery Warning"

    device_class: problem


# ====================================================
# SENSORS
# ====================================================

sensor:

  # --------------------------------------------------
  # AMBIENT LIGHT
  #
  # GPIO3
  # --------------------------------------------------

  - platform: adc

    pin: GPIO3

    id: ambient_light_raw

    name: "Ambient Light Raw"

    attenuation: 12db

    unit_of_measurement: "V"

    device_class: voltage

    state_class: measurement

    accuracy_decimals: 3

    update_interval: never


  # --------------------------------------------------
  # RAW BATTERY ADC
  #
  # GPIO1
  # --------------------------------------------------

  - platform: adc

    pin: GPIO1

    id: battery_adc_raw

    name: "Battery ADC Raw"

    attenuation: 12db

    unit_of_measurement: "V"

    device_class: voltage

    state_class: measurement

    accuracy_decimals: 4

    update_interval: never

    filters:

      - sliding_window_moving_average:
          window_size: 5
          send_every: 5
          send_first_at: 5


  # --------------------------------------------------
  # BATTERY VOLTAGE
  # --------------------------------------------------

  - platform: template

    id: battery_voltage

    name: "Battery Voltage"

    unit_of_measurement: "V"

    device_class: voltage

    state_class: measurement

    accuracy_decimals: 2

    update_interval: never

    lambda: |-
      float raw = id(battery_adc_raw).state;

      if (isnan(raw)) {
        return NAN;
      }

      return raw * 3.7625;


  # --------------------------------------------------
  # BATTERY PERCENTAGE
  #
  # Piecewise LiPo approximation.
  # --------------------------------------------------

  - platform: template

    id: battery_percent

    name: "Battery Percentage"

    unit_of_measurement: "%"

    device_class: battery

    state_class: measurement

    accuracy_decimals: 0

    update_interval: never

    lambda: |-
      float v = id(battery_voltage).state;

      if (isnan(v)) {
        return NAN;
      }

      if (v >= 4.20) {
        return 100.0;
      }

      if (v >= 4.10) {
        return 90.0 + ((v - 4.10) * 100.0);
      }

      if (v >= 4.00) {
        return 80.0 + ((v - 4.00) * 100.0);
      }

      if (v >= 3.90) {
        return 65.0 + ((v - 3.90) * 150.0);
      }

      if (v >= 3.80) {
        return 45.0 + ((v - 3.80) * 200.0);
      }

      if (v >= 3.70) {
        return 25.0 + ((v - 3.70) * 200.0);
      }

      if (v >= 3.60) {
        return 10.0 + ((v - 3.60) * 150.0);
      }

      if (v >= 3.50) {
        return 5.0 + ((v - 3.50) * 50.0);
      }

      if (v >= 3.30) {
        return (v - 3.30) * 25.0;
      }

      return 0.0;


  # --------------------------------------------------
  # NUMERIC WAKE CAUSE
  #
  # Common values:
  #
  # 0 = Power/reset
  # 3 = EXT1 / PIR
  # 4 = Timer
  # --------------------------------------------------

  - platform: template

    id: wakeup_cause

    name: "Wakeup Cause"

    accuracy_decimals: 0

    update_interval: never

    lambda: |-
      return (float) esp_sleep_get_wakeup_cause();


# ====================================================
# TEXT WAKE REASON
# ====================================================

text_sensor:

  - platform: template

    id: wakeup_reason

    name: "Wakeup Reason"

    update_interval: never

    lambda: |-
      esp_sleep_wakeup_cause_t reason =
        esp_sleep_get_wakeup_cause();

      switch (reason) {

        case ESP_SLEEP_WAKEUP_EXT1:
          return {"PIR Motion"};

        case ESP_SLEEP_WAKEUP_TIMER:
          return {"Battery Protection Timer"};

        case ESP_SLEEP_WAKEUP_UNDEFINED:
          return {"Power On / Reset"};

        default:
          return {"Other"};
      }


# ====================================================
# DEEP SLEEP
# ====================================================

deep_sleep:

  id: deep_sleep_control


  # --------------------------------------------------
  # FAILSAFE AWAKE LIMIT
  #
  # Normally the on_boot automation puts the ESP32
  # to sleep much sooner.
  # --------------------------------------------------

  run_duration: 30s


  # --------------------------------------------------
  # NORMAL PIR WAKE
  #
  # GPIO4 going HIGH wakes the ESP32-S3.
  #
  # ESP32-S3 supports EXT1 ANY_HIGH wake.
  # --------------------------------------------------

  esp32_ext1_wakeup:

    pins:

      - number: GPIO4
        allow_other_uses: true

    mode: ANY_HIGH
