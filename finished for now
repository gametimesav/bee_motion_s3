substitutions:
  low_battery_percent: "20"
  critical_battery_voltage: "3.40"

  # Ambient-light thresholds.
  #
  # Become DARK at or below 0.25 V.
  # Become LIGHT again at or above 0.35 V.
  dark_on_voltage: "0.25"
  dark_off_voltage: "0.35"


# ====================================================
# ESPHOME
# ====================================================

esphome:
  name: bee-motion-s3
  friendly_name: "Bee Motion S3"
  comment: "Bee Motion S3 optimized deep sleep with battery protection and dark detection"

  on_boot:
    priority: -10
    then:

      # Wait for Home Assistant to subscribe to states.
      - wait_until:
          condition:
            api.connected:
              state_subscription_only: true
          timeout: 20s

      # Give Wi-Fi/API startup current time to settle.
      - delay: 2s

      # ------------------------------------------------
      # AMBIENT LIGHT
      # ------------------------------------------------

      - component.update: ambient_light_raw

      # Give the ADC reading a moment to publish.
      #
      # "It Is Dark" automatically re-evaluates from
      # ambient_light_raw while the device is awake.
      - delay: 250ms


      # ------------------------------------------------
      # BATTERY SAMPLING
      #
      # Take five samples and average them.
      # ------------------------------------------------

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw

      # Allow averaged ADC value to publish.
      - delay: 250ms


      # ------------------------------------------------
      # CALCULATED BATTERY VALUES
      # ------------------------------------------------

      - component.update: battery_voltage
      - component.update: battery_percent

      - delay: 250ms


      # ------------------------------------------------
      # WAKE DIAGNOSTICS
      # ------------------------------------------------

      - component.update: wakeup_cause
      - component.update: wakeup_reason


      # ------------------------------------------------
      # LOW BATTERY WARNING
      # ------------------------------------------------

      - binary_sensor.template.publish:
          id: low_battery_warning
          state: !lambda |-
            float p = id(battery_percent).state;

            if (isnan(p)) {
              return false;
            }

            return p <= ${low_battery_percent};


      # ------------------------------------------------
      # CRITICAL BATTERY WARNING
      # ------------------------------------------------

      - binary_sensor.template.publish:
          id: critical_battery_warning
          state: !lambda |-
            float v = id(battery_voltage).state;

            if (isnan(v)) {
              return false;
            }

            return v <= ${critical_battery_voltage};


      # Give Home Assistant time to receive everything.
      - delay: 2s


      # =================================================
      # CRITICAL BATTERY PROTECTION
      # =================================================

      - if:
          condition:
            lambda: |-
              float v = id(battery_voltage).state;

              return !isnan(v) &&
                     v <= ${critical_battery_voltage};

          then:

            - logger.log:
                level: WARN
                format: "CRITICAL BATTERY: %.2f V - entering protective sleep"
                args:
                  - 'id(battery_voltage).state'

            # Give HA time to receive warning.
            - delay: 2s

            # Shut down PIR/light peripheral rail.
            #
            # PIR will not wake the ESP32 during the
            # protective sleep period.
            - switch.turn_off: peripheral_power

            - delay: 100ms

            # Wake every six hours to recheck battery.
            - deep_sleep.enter:
                id: deep_sleep_control
                sleep_duration: 6h

          else:

            # Normal battery level:
            # return immediately to PIR-wake deep sleep.
            - deep_sleep.enter: deep_sleep_control


# ====================================================
# ESP32-S3
# ====================================================

esp32:
  board: esp32-s3-devkitc-1

  framework:
    type: arduino


# ====================================================
# LOGGER
# ====================================================

logger:
  level: INFO


# ====================================================
# HOME ASSISTANT API
# ====================================================

api:
  id: api_server

  encryption:
    key: !secret bee_motion_s3__encryption_key

  reboot_timeout: 0s


# ====================================================
# OTA
# ====================================================

ota:
  - platform: esphome
    password: !secret bee_motion_s3__ota_password


# ====================================================
# WI-FI
# ====================================================

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  fast_connect: true


# ====================================================
# PERIPHERAL POWER
#
# GPIO34 = LDO2 / peripheral rail
#
# Must remain ON during normal deep sleep so the PIR
# can detect motion and wake the ESP32.
# ====================================================

switch:

  - platform: gpio
    pin:
      number: GPIO34

    id: peripheral_power

    internal: true

    restore_mode: ALWAYS_ON


# ====================================================
# BINARY SENSORS
# ====================================================

binary_sensor:

  # --------------------------------------------------
  # PIR MOTION
  #
  # GPIO4
  # --------------------------------------------------

  - platform: gpio

    pin:
      number: GPIO4

      mode:
        input: true
        pulldown: true

      allow_other_uses: true

    id: pir_motion

    name: "PIR Motion"

    device_class: motion

    filters:
      - delayed_off: 5s


  # --------------------------------------------------
  # USB / VBUS DETECTION
  #
  # GPIO2
  # --------------------------------------------------

  - platform: gpio

    pin:
      number: GPIO2

      mode:
        input: true

    id: usb_connected

    name: "USB Connected"

    device_class: plug


  # --------------------------------------------------
  # DARK / LIGHT TEMPLATE
  #
  # Uses hysteresis:
  #
  # <= 0.25 V  -> DARK
  # >= 0.35 V  -> LIGHT
  #
  # Between those values, retain previous state.
  # --------------------------------------------------

  - platform: template

    id: is_dark

    name: "It Is Dark"

    lambda: |-
      float light = id(ambient_light_raw).state;

      if (isnan(light)) {
        return {};
      }

      if (light <= ${dark_on_voltage}) {
        return true;
      }

      if (light >= ${dark_off_voltage}) {
        return false;
      }

      // Keep previous state while inside hysteresis band.
      return {};


  # --------------------------------------------------
  # LOW BATTERY WARNING
  # --------------------------------------------------

  - platform: template

    id: low_battery_warning

    name: "Low Battery Warning"

    device_class: battery


  # --------------------------------------------------
  # CRITICAL BATTERY WARNING
  # --------------------------------------------------

  - platform: template

    id: critical_battery_warning

    name: "Critical Battery Warning"

    device_class: problem


# ====================================================
# SENSORS
# ====================================================

sensor:

  # --------------------------------------------------
  # AMBIENT LIGHT
  #
  # GPIO3
  # --------------------------------------------------

  - platform: adc

    pin: GPIO3

    id: ambient_light_raw

    name: "Ambient Light Raw"

    attenuation: 12db

    unit_of_measurement: "V"

    device_class: voltage

    state_class: measurement

    accuracy_decimals: 3

    update_interval: never


  # --------------------------------------------------
  # RAW BATTERY ADC
  #
  # GPIO1
  # --------------------------------------------------

  - platform: adc

    pin: GPIO1

    id: battery_adc_raw

    name: "Battery ADC Raw"

    attenuation: 12db

    unit_of_measurement: "V"

    device_class: voltage

    state_class: measurement

    accuracy_decimals: 4

    update_interval: never

    filters:
      - sliding_window_moving_average:
          window_size: 5
          send_every: 5
          send_first_at: 5


  # --------------------------------------------------
  # BATTERY VOLTAGE
  # --------------------------------------------------

  - platform: template

    id: battery_voltage

    name: "Battery Voltage"

    unit_of_measurement: "V"

    device_class: voltage

    state_class: measurement

    accuracy_decimals: 2

    update_interval: never

    lambda: |-
      float raw = id(battery_adc_raw).state;

      if (isnan(raw)) {
        return NAN;
      }

      return raw * 3.7625;


  # --------------------------------------------------
  # BATTERY PERCENTAGE
  #
  # Piecewise LiPo approximation.
  # --------------------------------------------------

  - platform: template

    id: battery_percent

    name: "Battery Percentage"

    unit_of_measurement: "%"

    device_class: battery

    state_class: measurement

    accuracy_decimals: 0

    update_interval: never

    lambda: |-
      float v = id(battery_voltage).state;

      if (isnan(v)) {
        return NAN;
      }

      if (v >= 4.20) {
        return 100.0;
      }

      if (v >= 4.10) {
        return 90.0 + ((v - 4.10) * 100.0);
      }

      if (v >= 4.00) {
        return 80.0 + ((v - 4.00) * 100.0);
      }

      if (v >= 3.90) {
        return 65.0 + ((v - 3.90) * 150.0);
      }

      if (v >= 3.80) {
        return 45.0 + ((v - 3.80) * 200.0);
      }

      if (v >= 3.70) {
        return 25.0 + ((v - 3.70) * 200.0);
      }

      if (v >= 3.60) {
        return 10.0 + ((v - 3.60) * 150.0);
      }

      if (v >= 3.50) {
        return 5.0 + ((v - 3.50) * 50.0);
      }

      if (v >= 3.30) {
        return (v - 3.30) * 25.0;
      }

      return 0.0;


  # --------------------------------------------------
  # NUMERIC WAKE CAUSE
  #
  # 0 = Power/reset
  # 3 = EXT1/PIR
  # 4 = Timer
  # --------------------------------------------------

  - platform: template

    id: wakeup_cause

    name: "Wakeup Cause"

    accuracy_decimals: 0

    update_interval: never

    lambda: |-
      return (float) esp_sleep_get_wakeup_cause();


# ====================================================
# TEXT WAKE REASON
# ====================================================

text_sensor:

  - platform: template

    id: wakeup_reason

    name: "Wakeup Reason"

    update_interval: never

    lambda: |-
      esp_sleep_wakeup_cause_t reason =
        esp_sleep_get_wakeup_cause();

      switch (reason) {

        case ESP_SLEEP_WAKEUP_EXT1:
          return {"PIR Motion"};

        case ESP_SLEEP_WAKEUP_TIMER:
          return {"Battery Protection Timer"};

        case ESP_SLEEP_WAKEUP_UNDEFINED:
          return {"Power On / Reset"};

        default:
          return {"Other"};
      }


# ====================================================
# DEEP SLEEP
# ====================================================

deep_sleep:

  id: deep_sleep_control


  # --------------------------------------------------
  # FAILSAFE
  #
  # Normally on_boot sends the device to sleep much
  # sooner. This prevents it staying awake indefinitely
  # if Wi-Fi/API handling fails.
  # --------------------------------------------------

  run_duration: 30s


  # --------------------------------------------------
  # PIR WAKE
  #
  # Wake when GPIO4 goes HIGH.
  # --------------------------------------------------

  esp32_ext1_wakeup:

    pins:
      - number: GPIO4
        allow_other_uses: true

    mode: ANY_HIGH
