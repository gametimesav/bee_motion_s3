substitutions:
  low_battery_percent: "20"
  critical_battery_voltage: "3.40"


# ====================================================
# ESPHOME
# ====================================================

esphome:
  name: bee-motion-s3
  friendly_name: "Bee Motion S3"
  comment: "Bee Motion S3 optimized deep sleep with motion clear and battery protection"

  on_boot:
    priority: -10
    then:

      # Wait for Home Assistant to subscribe to states.
      - wait_until:
          condition:
            api.connected:
              state_subscription_only: true
          timeout: 20s

      # Let Wi-Fi/API startup current settle.
      - delay: 2s


      # ------------------------------------------------
      # AMBIENT LIGHT
      # ------------------------------------------------

      - component.update: ambient_light_raw
      - delay: 250ms


      # ------------------------------------------------
      # BATTERY SAMPLING
      #
      # Five samples are averaged before being published.
      # ------------------------------------------------

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms

      - component.update: battery_adc_raw
      - delay: 250ms


      # ------------------------------------------------
      # CALCULATED BATTERY VALUES
      # ------------------------------------------------

      - component.update: battery_voltage
      - component.update: battery_percent
      - delay: 250ms


      # ------------------------------------------------
      # WAKE DIAGNOSTICS
      # ------------------------------------------------

      - component.update: wakeup_cause
      - component.update: wakeup_reason


      # ------------------------------------------------
      # LOW BATTERY WARNING
      # ------------------------------------------------

      - binary_sensor.template.publish:
          id: low_battery_warning
          state: !lambda |-
            float p = id(battery_percent).state;

            if (isnan(p)) {
              return false;
            }

            return p <= ${low_battery_percent};


      # ------------------------------------------------
      # CRITICAL BATTERY WARNING
      # ------------------------------------------------

      - binary_sensor.template.publish:
          id: critical_battery_warning
          state: !lambda |-
            float v = id(battery_voltage).state;

            if (isnan(v)) {
              return false;
            }

            return v <= ${critical_battery_voltage};


      # Give Home Assistant time to receive readings.
      - delay: 2s


      # =================================================
      # CRITICAL BATTERY PROTECTION
      # =================================================

      - if:
          condition:
            lambda: |-
              float v = id(battery_voltage).state;

              return !isnan(v) &&
                     v <= ${critical_battery_voltage};

          then:

            - logger.log:
                level: WARN
                format: "CRITICAL BATTERY: %.2f V - entering protective sleep"
                args:
                  - 'id(battery_voltage).state'

            - delay: 2s

            # Turn off PIR/light peripheral rail.
            # This prevents motion wake during protective sleep.
            - switch.turn_off: peripheral_power

            - delay: 100ms

            # Wake in six hours to check battery again.
            - deep_sleep.enter:
                id: deep_sleep_control
                sleep_duration: 6h


          # =================================================
          # NORMAL OPERATION
          # =================================================

          else:

            # ------------------------------------------------
            # MOTION CLEAR FIX
            #
            # Do not sleep while PIR is still active.
            # This allows Home Assistant to receive OFF/Clear.
            # ------------------------------------------------

            - wait_until:
                condition:
                  binary_sensor.is_off: pir_motion
                timeout: 15s

            # PIR has a 1-second delayed_off filter.
            # Give that filter time to finish.
            - delay: 1500ms

            # Extra time for Home Assistant to receive OFF.
            - delay: 1s

            - logger.log:
                level: INFO
                format: "PIR clear - entering deep sleep"

            - deep_sleep.enter: deep_sleep_control


# ====================================================
# ESP32-S3
# ====================================================

esp32:
  board: esp32-s3-devkitc-1

  framework:
    type: arduino


# ====================================================
# LOGGER
# ====================================================

logger:
  level: INFO


# ====================================================
# HOME ASSISTANT API
# ====================================================

api:
  id: api_server

  encryption:
    key: !secret bee_motion_s3__encryption_key

  reboot_timeout: 0s


# ====================================================
# OTA
# ====================================================

ota:
  - platform: esphome
    password: !secret bee_motion_s3__ota_password


# ====================================================
# WI-FI
# ====================================================

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  fast_connect: true


# ====================================================
# PERIPHERAL POWER
#
# GPIO34 = LDO2 / peripheral rail.
#
# This remains ON during normal deep sleep so the
# PIR can continue detecting motion.
# ====================================================

switch:

  - platform: gpio

    pin:
      number: GPIO34

    id: peripheral_power

    internal: true

    restore_mode: ALWAYS_ON


# ====================================================
# BINARY SENSORS
# ====================================================

binary_sensor:

  # --------------------------------------------------
  # PIR MOTION
  #
  # GPIO4
  # --------------------------------------------------

  - platform: gpio

    pin:
      number: GPIO4

      mode:
        input: true
        pulldown: true

      allow_other_uses: true

    id: pir_motion

    name: "PIR Motion"

    device_class: motion

    # Reduced from 5 seconds.
    # This lets Home Assistant see Clear/Off before
    # the device returns to deep sleep.
    filters:
      - delayed_off: 1s


  # --------------------------------------------------
  # USB / VBUS DETECTION
  #
  # GPIO2
  # --------------------------------------------------

  - platform: gpio

    pin:
      number: GPIO2

      mode:
        input: true

    id: usb_connected

    name: "USB Connected"

    device_class: plug


  # --------------------------------------------------
  # LOW BATTERY WARNING
  # --------------------------------------------------

  - platform: template

    id: low_battery_warning

    name: "Low Battery Warning"

    device_class: battery


  # --------------------------------------------------
  # CRITICAL BATTERY WARNING
  # --------------------------------------------------

  - platform: template

    id: critical_battery_warning

    name: "Critical Battery Warning"

    device_class: problem


# ====================================================
# SENSORS
# ====================================================

sensor:

  # --------------------------------------------------
  # AMBIENT LIGHT
  #
  # GPIO3
  # --------------------------------------------------

  - platform: adc

    pin: GPIO3

    id: ambient_light_raw

    name: "Ambient Light Raw"

    attenuation: 12db

    unit_of_measurement: "V"

    device_class: voltage
    state_class: measurement

    accuracy_decimals: 3

    update_interval: never


  # --------------------------------------------------
  # RAW BATTERY ADC
  #
  # GPIO1
  # --------------------------------------------------

  - platform: adc

    pin: GPIO1

    id: battery_adc_raw

    name: "Battery ADC Raw"

    attenuation: 12db

    unit_of_measurement: "V"

    device_class: voltage
    state_class: measurement

    accuracy_decimals: 4

    update_interval: never

    filters:
      - sliding_window_moving_average:
          window_size: 5
          send_every: 5
          send_first_at: 5


  # --------------------------------------------------
  # BATTERY VOLTAGE
  # --------------------------------------------------

  - platform: template

    id: battery_voltage

    name: "Battery Voltage"

    unit_of_measurement: "V"

    device_class: voltage
    state_class: measurement

    accuracy_decimals: 2

    update_interval: never

    lambda: |-
      float raw = id(battery_adc_raw).state;

      if (isnan(raw)) {
        return NAN;
      }

      return raw * 3.7625;


  # --------------------------------------------------
  # BATTERY PERCENTAGE
  #
  # Approximate single-cell LiPo discharge curve.
  # --------------------------------------------------

  - platform: template

    id: battery_percent

    name: "Battery Percentage"

    unit_of_measurement: "%"

    device_class: battery
    state_class: measurement

    accuracy_decimals: 0

    update_interval: never

    lambda: |-
      float v = id(battery_voltage).state;

      if (isnan(v)) {
        return NAN;
      }

      if (v >= 4.20) return 100.0;
      if (v >= 4.10) return 90.0 + ((v - 4.10) * 100.0);
      if (v >= 4.00) return 80.0 + ((v - 4.00) * 100.0);
      if (v >= 3.90) return 65.0 + ((v - 3.90) * 150.0);
      if (v >= 3.80) return 45.0 + ((v - 3.80) * 200.0);
      if (v >= 3.70) return 25.0 + ((v - 3.70) * 200.0);
      if (v >= 3.60) return 10.0 + ((v - 3.60) * 150.0);
      if (v >= 3.50) return 5.0 + ((v - 3.50) * 50.0);
      if (v >= 3.30) return (v - 3.30) * 25.0;

      return 0.0;


  # --------------------------------------------------
  # NUMERIC WAKE CAUSE
  #
  # 0 = power/reset
  # 3 = EXT1 / PIR
  # 4 = timer
  # --------------------------------------------------

  - platform: template

    id: wakeup_cause

    name: "Wakeup Cause"

    accuracy_decimals: 0

    update_interval: never

    lambda: |-
      return (float) esp_sleep_get_wakeup_cause();


# ====================================================
# TEXT WAKE REASON
# ====================================================

text_sensor:

  - platform: template

    id: wakeup_reason

    name: "Wakeup Reason"

    update_interval: never

    lambda: |-
      esp_sleep_wakeup_cause_t reason =
        esp_sleep_get_wakeup_cause();

      switch (reason) {

        case ESP_SLEEP_WAKEUP_EXT1:
          return {"PIR Motion"};

        case ESP_SLEEP_WAKEUP_TIMER:
          return {"Battery Protection Timer"};

        case ESP_SLEEP_WAKEUP_UNDEFINED:
          return {"Power On / Reset"};

        default:
          return {"Other"};
      }


# ====================================================
# DEEP SLEEP
# ====================================================

deep_sleep:

  id: deep_sleep_control


  # Failsafe awake time.
  #
  # Normally on_boot sends the board back to sleep
  # sooner. If something goes wrong, it will not
  # stay awake forever.
  run_duration: 30s


  # --------------------------------------------------
  # PIR WAKE
  #
  # Wake ESP32-S3 when GPIO4 goes HIGH.
  # --------------------------------------------------

  esp32_ext1_wakeup:

    pins:
      - number: GPIO4
        allow_other_uses: true

    mode: ANY_HIGH
